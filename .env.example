# SuperScout Environment Variables
# ─────────────────────────────────────────────────────────────────────────────
# Copy this file to .env and fill in your local / environment values.
# NEVER commit .env to version control.
# ─────────────────────────────────────────────────────────────────────────────

# ── Database Configuration (PostgreSQL / Alembic) ───────────────
# Connection string format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL=postgresql://superscout:password@localhost:5432/superscout_db

# PostgreSQL credentials for local development / Docker setup
POSTGRES_USER=superscout
POSTGRES_PASSWORD=password
POSTGRES_DB=superscout_db
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# ── API Server Configuration ──────────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8000

# Set to true only in local development.
DEBUG=false

# Logging level: DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=INFO

# Comma-separated list of allowed CORS origins.
ALLOWED_ORIGINS=http://localhost:3000

# ── Frontend Configuration ───────────────────────────────────────────────────
# Must be prefixed with NEXT_PUBLIC_ to be accessible in Next.js browser context.
NEXT_PUBLIC_API_URL=http://localhost:8000

# ── Data Ingestion & Data Foundation (Phase 2) ──────────────────────────────
DATA_RAW_DIR=data/raw
DATA_PROCESSED_DIR=data/processed
DATA_EXTERNAL_DIR=data/external
