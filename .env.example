# SuperScout Environment Variables
# ─────────────────────────────────────────────────────────────────────────────
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# The .gitignore already excludes .env — keep it that way.
# ─────────────────────────────────────────────────────────────────────────────

# ── Database ──────────────────────────────────────────────────────────────────
# PostgreSQL connection string.
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL=postgresql://superscout:password@localhost:5432/superscout_db

# ── API Server ────────────────────────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8000

# Set to true only in development. Never use true in production.
DEBUG=false

# Logging level: DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=INFO

# Comma-separated list of allowed CORS origins.
# In development: http://localhost:3000
# In production: https://yourdomain.com
ALLOWED_ORIGINS=http://localhost:3000

# ── Frontend ──────────────────────────────────────────────────────────────────
# Must be prefixed with NEXT_PUBLIC_ to be accessible in the browser.
NEXT_PUBLIC_API_URL=http://localhost:8000

# ── Future: Authentication (Phase N) ─────────────────────────────────────────
# SECRET_KEY=
# ACCESS_TOKEN_EXPIRE_MINUTES=

# ── Future: External Data Sources (Phase 2) ──────────────────────────────────
# CRICKET_DATA_API_KEY=
# CRICKET_DATA_API_URL=
